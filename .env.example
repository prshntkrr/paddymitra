SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=irri_ai
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Sarvam AI. One key for both directions: speech-to-text below, and the Odia
# text-to-speech that speaks the answer. Leave blank to disable Sarvam (STT then
# falls back to the local Wav2Vec2 model; TTS raises rather than return silence).
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saarika:v2.5

# Odia text-to-speech (optional — these are the defaults).
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE_CODE=od-IN
SARVAM_TTS_PACE=0.9

# Picky Assist (WhatsApp gateway)
PICKY_ASSIST_TOKEN=your-picky-assist-token
PICKY_ASSIST_WEBHOOK_SECRET=your-webhook-secret
PICKY_ASSIST_SEND_URL=https://api.pickyassist.com/v1/outbound/send

# Docling (structure-aware PDF chunking, produced offline by docling_ingest.py).
# When a cached chunk file exists for a PDF, Docling is used in preference to
# Sherpa. Docling is not a runtime dependency — only its JSON cache is read.
USE_DOCLING=1
# DOCLING_CACHE_DIR=            # defaults to <project>/docling_cache

# LLM Sherpa (structure-aware PDF parsing). Leave empty to use pypdf fallback.
# Used only when no Docling cache exists for a given PDF.
LLM_SHERPA_API_URL=http://13.235.211.12:8003/api/parseDocument?renderFormat=all

# Retrieval tuning
RRF_K=60

# Cross-encoder reranking (optional, off by default)
USE_CROSS_ENCODER=0
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Feature flags
USE_LOCAL_EMBEDDINGS=0
